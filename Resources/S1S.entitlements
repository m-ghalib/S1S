<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- S1S needs to observe/inject events system-wide and read text via the
         Accessibility API, so it runs unsandboxed with no App Sandbox entitlement. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
